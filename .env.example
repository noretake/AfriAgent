NODE_ENV=development

PORT=3001

CLIENT_URL=http://localhost:5173

# When true (or when Supabase/Binance credentials are missing) the app runs fully
# self-contained with MockBinanceService and seeded demo data.
DEMO_MODE=true

# Optional: persist to Supabase/PostgreSQL. Apply server/src/db/schema.sql and seed.sql first.
# When absent, an in-memory store seeded with the demo data is used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: LLM provider (openai | anthropic). Without a key the deterministic dev parser is used.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional: real exchange credentials. Never required for Demo Mode.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: point at Binance Spot testnet (https://testnet.binance.vision) to trade with fake funds.
# BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_BASE_URL=
BINANCE_MCP_ENDPOINT=
APPROVAL_TTL_MINUTES=10
