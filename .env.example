NODE_ENV=development

PORT=3001

CLIENT_URL=http://localhost:5173

# When true (or when Supabase/Binance credentials are missing) the app runs fully
# self-contained with MockBinanceService and seeded demo data.
DEMO_MODE=true
# Seed illustrative past transactions/approvals/audit events on first start when history is empty.
# Defaults to DEMO_MODE's value; set explicitly to override.
SEED_SAMPLE_DATA=

# Optional: persist to Supabase/PostgreSQL. Apply server/src/db/schema.sql and seed.sql first.
# When absent, an in-memory store seeded with the demo data is used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth. Defaults to true when DEMO_MODE=false (live exchange) and needs SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY; every request must carry a Supabase access token. Set true to enable in Demo Mode.
REQUIRE_AUTH=

# Frontend (Vite, build-time). Both must be set for the login screen; leave empty for the shared demo user.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: LLM provider (openai | anthropic). Without a key the deterministic dev parser is used.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional: real exchange credentials. Never required for Demo Mode.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: point at Binance Spot testnet (https://testnet.binance.vision) to trade with fake funds.
# BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_BASE_URL=
BINANCE_MCP_ENDPOINT=
APPROVAL_TTL_MINUTES=10
